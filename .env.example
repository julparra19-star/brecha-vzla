# ===========================================
# BrechaVzla - Variables de Entorno
# ===========================================
# Copia este archivo como .env y completa los valores

# Puerto del servidor Express
PORT=3000

# Supabase - Crear cuenta gratuita en https://supabase.com
# Obtener credenciales en: Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-clave-anonima-aqui

# Horarios de alertas (formato cron: minuto hora)
# Por defecto: 9:00 AM, 12:00 PM, 6:00 PM
ALERT_CRON=0 9,12,18 * * *
